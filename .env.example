# Optional. bin/smrt reads ~/.config/smrt/config (same shell syntax) or plain
# environment variables; this file is only used by scripts/ and the
# devcontainer. Copy to .env if you prefer keeping it repo-local.

# Vault. Mounted read-write at /vault.
SMRT_VAULT=$HOME/vault

# Default subject for the devcontainer only. bin/smrt uses $PWD.
# SMRT_SUBJECT=/absolute/path

# Auth — see docs/auth.md. Decision 1 in docs/OPEN.md is still open.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# SMRT_IMAGE=smrt:latest
# SMRT_STATE=$HOME/.local/share/smrt
